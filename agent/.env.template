# =============================================================================
# Microsoft Foundry — the project the MAF agent (agent/agent.py) connects to
# =============================================================================
# Populated automatically by azd after `azd up` (see infra/main.bicep outputs).
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4
AZURE_TENANT_ID=

# =============================================================================
# Foundry IQ — knowledge base MCP (scripts/create_foundry_iq_kb.py)
# =============================================================================
AZURE_AI_SEARCH_SERVICE_ENDPOINT=
AZURE_AI_SEARCH_KNOWLEDGE_BASE_NAME=noc-knowledge-kb

# =============================================================================
# Web IQ — Microsoft web MCP server, static API key (CustomKeys / x-apikey)
# =============================================================================
WEB_IQ_MCP_ENDPOINT=https://api.microsoft.ai/v3/mcp
# WEB_IQ_API_KEY=<set via azd env / Key Vault — never commit the real key>

# =============================================================================
# Fabric IQ — Fabric Data Agent MCP (scripts/create_fabric_ontology.py +
# scripts/create_fabric_data_agent.py)
# =============================================================================
FABRIC_DATA_AGENT_MCP_URL=
FABRIC_TENANT_ID=
FABRIC_WORKSPACE_ID=
FABRIC_CAPACITY_ID=
FABRIC_ONTOLOGY_ID=
FABRIC_ONTOLOGY_NAME=NOCNetworkOntology
FABRIC_DATA_AGENT_NAME=NOCNetworkDataAgent

# =============================================================================
# Work IQ — Foundry toolbox name (portal-configured connection, UserEntraToken)
# =============================================================================
CUSTOM_FOUNDRY_WORKIQ_TOOLBOX_NAME=work-iq-tools

# OBO token scope used to call Fabric IQ / Work IQ through the Foundry project.
# Do NOT use cognitiveservices.azure.com here.
# FOUNDRY_USER_TOKEN_SCOPES=https://ai.azure.com/.default

# =============================================================================
# A365 Authentication (populated by `a365 setup all`)
# =============================================================================
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__SCOPES=

AUTH_HANDLER_NAME=AGENTIC
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__TYPE=AgenticUserAuthorization
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__SCOPES=https://ai.azure.com/.default
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__ALT_BLUEPRINT_NAME=SERVICE_CONNECTION
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__ALTERNATEBLUEPRINTCONNECTIONNAME=https://ai.azure.com/.default

CONNECTIONSMAP_0_SERVICEURL=*
CONNECTIONSMAP_0_CONNECTION=SERVICE_CONNECTION

USE_AGENTIC_AUTH=true

# =============================================================================
# Observability (populated by a365 CLI)
# =============================================================================
ENABLE_OBSERVABILITY=true
ENABLE_A365_OBSERVABILITY_EXPORTER=false
PYTHON_ENVIRONMENT=development
LOG_LEVEL=INFO
APPLICATIONINSIGHTS_CONNECTION_STRING=

# AGENT_ID=<populated by a365 CLI>
# AGENT365OBSERVABILITY__AGENTID=<populated by a365 CLI>
# AGENT365OBSERVABILITY__AGENTBLUEPRINTID=<populated by a365 CLI>
# AGENT365OBSERVABILITY__CLIENTID=<populated by a365 CLI>
# AGENT365OBSERVABILITY__CLIENTSECRET=<populated by a365 CLI>
# AGENT365OBSERVABILITY__TENANTID=<populated by a365 CLI>
# AGENT365OBSERVABILITY__AGENTNAME=<populated by a365 CLI>
# AGENT365OBSERVABILITY__AGENTDESCRIPTION=<populated by a365 CLI>

# =============================================================================
# Server
# =============================================================================
PORT=3978
